@page
@model IndexModel
@{
    ViewData["Title"] = "Feed";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Feed</h1>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div>
            <a class="btn btn-outline-secondary me-2" asp-area="Identity" asp-page="/Account/Manage/Index">Mi cuenta</a>
        </div>
    }
    else
    {
        <div>
            <a class="btn btn-outline-primary me-2" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
            <a class="btn btn-outline-success" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a>
        </div>
    }
</div>

@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="post-form card mb-4 p-3">
        <form method="post" asp-page-handler="Create">
            <div class="mb-2">
                <textarea asp-for="Input.Content" class="form-control" rows="2" maxlength="140" placeholder="¿Qué está pasando? (140 caracteres máximo)"></textarea>
                <span asp-validation-for="Input.Content" class="text-danger"></span>
            </div>
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary">Publicar</button>
            </div>
        </form>
    </div>
}

@if (Model.Posts == null || !Model.Posts.Any())
{
    <div class="alert alert-info">No hay publicaciones todavía.</div>
}
else
{
    <div class="list-group">
        @foreach (var post in Model.Posts)
        {
            <div class="list-group-item mb-2 post-card">
                <div class="d-flex justify-content-between">
                    <div>
                        <strong>@(post.Author?.UserName ?? "(usuario)")</strong>
                        <small class="text-muted ms-2">@post.Created.ToLocalTime().ToString("g")</small>
                        @if (post.Edited)
                        {
                            <small class="text-muted ms-2">(editado)</small>
                        }
                    </div>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        var userId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                        if (userId == post.AuthorId && (DateTime.UtcNow - post.Created) <= TimeSpan.FromMinutes(5))
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-page="/Posts/Edit" asp-route-id="@post.Id">Editar</a>
                        }
                    }
                </div>
                <p class="mt-2">@post.Content</p>
            </div>
        }
    </div>
}
